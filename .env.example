# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/nexflow

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security & Encryption Secrets
SECRET_KEY=dev-secret-key-change-in-production-12345
CREDENTIAL_ENCRYPTION_KEY=32-character-base64-key-for-aes-gcm

# Project Details
PROJECT_NAME=NexFlow
API_V1_STR=/api/v1

# SMTP Email Configuration (Optional - for Workspace User Invitations & Emails)
# Example using Mailtrap (dev/testing) or Gmail SMTP:
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=noreply@nexflow.io
EMAILS_FROM_NAME=NexFlow Automation
